APP_ENV=development
APP_SECRET_KEY=
DEBUG=true
FERNET_KEY=

# Async Postgres URL. Locally: postgresql+asyncpg://user:pass@localhost:5432/socialforge
# On Railway paste the plugin's DATABASE_URL as-is (scheme is normalized automatically).
DATABASE_URL=
REDIS_URL=

# Admin panel (HTTP Basic) — protects every mutating/admin endpoint.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Local docker-compose only (compose reads these).
POSTGRES_DB=socialforge
POSTGRES_USER=socialforge
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Bootstrap provider keys (optional fallbacks; per-brand keys live encrypted in DB).
BOOTSTRAP_ANTHROPIC_KEY=
BOOTSTRAP_OPENAI_KEY=
BOOTSTRAP_APIFY_KEY=
